{
  "name": "oracle-reporting-tool-desktop",
  "description": "Oracle Reporting Tool desktop application",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "main": "electron-build/main.js",
  "scripts": {
    "dev": "concurrently -k --success first \"vite\" \"wait-on http://localhost:5173 && npm run electron:dev\"",
    "electron:dev": "tsc -p tsconfig.electron.json && electron .",
    "build": "tsc -b && vite build && tsc -p tsconfig.electron.json",
    "dist:win": "npm run build && electron-builder --win nsis",
    "release:win": "npm run build && electron-builder --win nsis --publish always",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.cfi.oracle-reporting-tool",
    "productName": "Oracle Reporting Tool",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "${productName}-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MarcelitoCabanero",
        "repo": "oracle-reporting-tool-desktop",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "basic-ftp": "^6.2.1",
    "bootstrap": "^5.3.8",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.37.0",
    "mssql": "^12.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
